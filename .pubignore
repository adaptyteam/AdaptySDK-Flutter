# The tests of the contract and of the native probe, and what only they read. Each rule starts at the root:
# without the /, contract/ would also leave out test/contract/ and tool/contract/ wherever they are needed.
# The schema stays in the package: it is the contract of the method channel the native plugins implement.
/contract/*
!/contract/cross_platform.yaml
/integration_test_app/
/tool/contract/
/tool/l2a/
/test/contract/
/test/support/contract/
/test/tool/
# Routes each event of the contract corpus, so it reads contract/ and tool/contract/.
/test/event_routing_test.dart
